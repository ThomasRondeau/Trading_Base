# Copy this file to .env and fill in the values (.env is gitignored).
MASSIVE_API_KEY=

# IBKR (TWS / IB Gateway). Default TWS ports: 7497 paper, 7496 live (IB Gateway: 4002 / 4001).
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=5
# Orders are refused unless IBKR_READ_ONLY=false (read-only = data + shadow mode with simulated fills).
IBKR_READ_ONLY=true
# Orders are refused on a real-money account (not DU...) unless IBKR_ALLOW_LIVE=true.
IBKR_ALLOW_LIVE=false
