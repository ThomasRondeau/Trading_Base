# Copy this file to .env and fill in the values (.env is gitignored).
MASSIVE_API_KEY=

# IBKR (TWS / IB Gateway). Default TWS ports: 7497 paper, 7496 live (IB Gateway: 4002 / 4001).
IBKR_HOST=127.0.0.1
# Account used by default (CLI --account / UI Configuration page override it): paper or live
IBKR_ACCOUNT=paper
IBKR_PORT_PAPER=7497
# Port of the real-money account session
IBKR_PORT=7496
IBKR_CLIENT_ID=5
# Orders are refused unless IBKR_READ_ONLY=false (read-only = data + shadow mode with simulated fills).
IBKR_READ_ONLY=true
# Orders are refused on a real-money account (not DU...) unless IBKR_ALLOW_LIVE=true.
IBKR_ALLOW_LIVE=false
